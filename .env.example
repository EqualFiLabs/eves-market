# Robinhood Chain testnet endpoints. Never commit a populated private key.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_VERIFIER_URL=https://explorer.testnet.chain.robinhood.com/api/
BASESCAN_API_KEY=unused
PRIVATE_KEY=

# Predeploy these dependencies and use their confirmed addresses.
CONDITIONAL_TOKENS=
USDC_TOKEN=
MOCK_USDG_OWNER=
# Use the deployment broadcaster here when FAUCET_USDC_FUND_AMOUNT is nonzero.
MOCK_USDG_INITIAL_RECIPIENT=
MOCK_USDG_INITIAL_SUPPLY=

# Governance and treasury.
INITIAL_OWNER=
EVE_TREASURY=
INITIAL_GOVERNANCE_DELAY_SECONDS=900
MLO_PROFIT_SPLIT_DELAY_SECONDS=900

# Canonical Statics Dollar integration. USDC-named variables carry USDG.
STATICS_DOLLAR_CORE_ADDRESS=
STATICS_DOLLAR_USDC_PROFILE_ID=
ENABLE_STATICS_DOLLAR_MARKETS=true

# Testnet market policy.
PERMISSIONLESS_CREATION_ENABLED=true
MARKET_CREATION_FEE=1000000
MARKET_CREATION_BOND_EVE=1000000000000000000
RESOLUTION_BOND_L1=100000000000000000
RESOLUTION_BOND_L2=500000000000000000
MIN_MARKET_DURATION=60
MAX_MARKET_DURATION=2592000
DISPUTE_WINDOW=600
CREATOR_SETTLE_GRACE=600
OPEN_RESOLUTION_TIMEOUT=600
MAX_ESCALATION=3
MLO_DEFAULT_FUNDING_RATE_PER_SECOND_WAD=0

# Optional predeployments. Leave these unset to use the launch fixtures.
# EVE_TOKEN=
# MLO_INSURANCE_FUND=
# FEE_RECIPIENT=
# FAUCET_OWNER=

# Faucet funding uses six decimals for Mock USDG.
FAUCET_USDC_ENABLED=true
FAUCET_EVE_ENABLED=true
FAUCET_USDC_CLAIM_AMOUNT=1000000000
FAUCET_EVE_CLAIM_AMOUNT=10000000000000000000000
FAUCET_USDC_FUND_AMOUNT=1000000000000
FAUCET_EVE_FUND_AMOUNT=10000000000000000000000000
